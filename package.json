{
  "name": "walmart-couple-scavenger-hunt",
  "version": "1.0.0",
  "description": "Two-player real-time store scavenger hunt for couples",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm install && cd client && npm install --include=dev && npm run build",
    "server": "node server/server.js",
    "client": "cd client && npm run dev",
    "test": "node test-game-flow.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "keywords": [
    "scavenger-hunt",
    "walmart",
    "couples-game",
    "realtime",
    "socketio"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "localtunnel": "^2.0.2",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "untun": "^0.2.2",
    "uuid": "^14.0.3"
  }
}
